<Window x:Class="Virtual_education_env.Admin.Admin_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кабинет администратора"
        Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="1000"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SideMenuPanel"
                Grid.Column="0"
                Background="{StaticResource PrimaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,24,20,24">
                    <Image Source="/Images/logo.jpg" Width="150"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="AppTitleTextBlock"
                               Text="Панель администратора"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="12,0">
                    <Button x:Name="MenuStudentsButton"
                            Content="Студенты"
                            Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="MenuTeachersButton"
                            Content="Преподаватели"
                            Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="MenuCoursesButton"
                            Content="Курсы"
                            Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="MenuGroupsButton"
                            Content="Группы"
                            Style="{StaticResource MenuButtonStyle}"/>
                    <Button x:Name="MenuEnrollmentsButton"
                            Content="Записи на курсы"
                            Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <Button x:Name="MenuLogoutButton"
                        Grid.Row="2"
                        Content="Выйти"
                        Style="{StaticResource MenuButtonStyle}"
                        Margin="12,0,12,20"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderPanel"
                    Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    Padding="32,20"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="WelcomeTextBlock"
                                   Text="Панель администратора"
                                   Style="{StaticResource HeaderTextStyle}"/>
                        <TextBlock x:Name="UserInfoTextBlock"
                                   Text="ФИО · Администратор"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="CurrentDateTextBlock"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <Frame x:Name="AdminFrame"
                   Grid.Row="1"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>
    </Grid>
</Window>