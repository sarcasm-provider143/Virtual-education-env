<Page x:Class="Virtual_education_env.Admin.AdminPages.AdminCoursesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Курсы"
      Background="Transparent">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header"
                   Grid.Row="0"
                   Text="Все курсы"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Style="{StaticResource TextBoxStyle}"
                     TextChanged="SearchTextBox_TextChanged"/>

            <Button x:Name="ClearSearchButton"
                    Grid.Column="2"
                    Content="Очистить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="120"
                    Click="ClearSearchButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <Button x:Name="AddCourseButton"
                    Content="+ Добавить курс"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="180"
                    Margin="0,0,12,0"
                    Click="AddCourseButton_Click"/>

            <Button x:Name="EditCourseButton"
                    Content="Редактировать"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="160"
                    Margin="0,0,12,0"
                    Click="EditCourseButton_Click"/>

            <Button x:Name="DeleteCourseButton"
                    Content="Удалить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="120"
                    Click="DeleteCourseButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="CoursesDataGrid"
                  Grid.Row="3"
                  Style="{StaticResource AppDataGridStyle}"
                  MouseDoubleClick="CoursesDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"           Binding="{Binding id}"           Width="60" Visibility="Hidden"/>
                <DataGridTextColumn Header="Название"     Binding="{Binding title}"        Width="*"/>
                <DataGridTextColumn Header="Преподаватель" Binding="{Binding teacher}"     Width="250"/>
                <DataGridTextColumn Header="Специальность" Binding="{Binding specialty}"   Width="200"/>
                <DataGridTextColumn Header="Часов"        Binding="{Binding hours}"        Width="80"/>
                <DataGridTextColumn Header="Дата начала"  Binding="{Binding startDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Студентов"    Binding="{Binding students}"     Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>