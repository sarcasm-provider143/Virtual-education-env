<Page x:Class="Virtual_education_env.Admin.AdminPages.AdminTeachersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Преподаватели"
      Background="Transparent">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header"
                   Grid.Row="0"
                   Text="Преподаватели"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Style="{StaticResource TextBoxStyle}"
                     TextChanged="SearchTextBox_TextChanged"/>

            <Button x:Name="ClearSearchButton"
                    Grid.Column="2"
                    Content="Очистить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="120"
                    Click="ClearSearchButton_Click"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <Button x:Name="AddTeacherButton"
                    Content="+ Добавить преподавателя"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="240"
                    Margin="0,0,12,0"
                    Click="AddTeacherButton_Click"/>

            <Button x:Name="EditTeacherButton"
                    Content="Редактировать"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="160"
                    Margin="0,0,12,0"
                    Click="EditTeacherButton_Click"/>

            <Button x:Name="DeleteTeacherButton"
                    Content="Удалить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="120"
                    Click="DeleteTeacherButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="TeachersDataGrid"
                  Grid.Row="3"
                  Style="{StaticResource AppDataGridStyle}"
                  MouseDoubleClick="TeachersDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"          Binding="{Binding id}"         Width="60" Visibility="Hidden"/>
                <DataGridTextColumn Header="Фамилия"     Binding="{Binding lastName}"   Width="150"/>
                <DataGridTextColumn Header="Имя"         Binding="{Binding firstName}"  Width="130"/>
                <DataGridTextColumn Header="Отчество"    Binding="{Binding middleName}" Width="150"/>
                <DataGridTextColumn Header="Должность"   Binding="{Binding position}"   Width="200"/>
                <DataGridTextColumn Header="Квалификация" Binding="{Binding degree}"    Width="200"/>
                <DataGridTextColumn Header="Логин"       Binding="{Binding login}"      Width="150"/>
                <DataGridTextColumn Header="Email"       Binding="{Binding email}"      Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>