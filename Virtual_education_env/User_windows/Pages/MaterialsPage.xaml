<Page x:Class="Virtual_education_env.User_windows.Pages.MaterialsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Virtual_education_env.User_windows.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Учебные материалы"
      Background="Transparent">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MaterialsHeader"
                   Grid.Row="0"
                   Text="Учебные материалы"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="MaterialsCourseLabel"
                       Text="Выберите курс"
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="MaterialsCourseComboBox"
                      Style="{StaticResource AppComboBoxStyle}"
                      Width="400"
                      HorizontalAlignment="Left"
                      SelectionChanged="MaterialsCourseComboBox_SelectionChanged"/>
        </StackPanel>

        <DataGrid x:Name="MaterialsDataGrid"
                  Grid.Row="2"
                  Style="{StaticResource AppDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип"      Binding="{Binding type}"  Width="120"/>
                <DataGridTextColumn Header="Название" Binding="{Binding title}" Width="*"/>
                <DataGridTextColumn Header="Ссылка"   Binding="{Binding link}"  Width="350"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
