<Page x:Class="Virtual_education_env.Teacher.TeacherPages.AddGradePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Выставить оценку"
      Background="Transparent">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header"
                   Grid.Row="0"
                   Text="Выставление оценки"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="CourseLabel"
                       Text="Курс"
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="CourseComboBox"
                      Style="{StaticResource AppComboBoxStyle}"
                      Width="500"
                      HorizontalAlignment="Left"
                      SelectionChanged="CourseComboBox_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock x:Name="StudentLabel"
                       Text="Студент"
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="StudentComboBox"
                      Style="{StaticResource AppComboBoxStyle}"
                      Width="500"
                      HorizontalAlignment="Left"
                      SelectionChanged="StudentComboBox_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock x:Name="MaterialLabel"
                       Text="Задание"
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="MaterialComboBox"
                      Style="{StaticResource AppComboBoxStyle}"
                      Width="500"
                      HorizontalAlignment="Left"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="GradeLabel"
                           Text="Оценка"
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="GradeComboBox"
                          Style="{StaticResource AppComboBoxStyle}"
                          Width="200"
                          HorizontalAlignment="Left">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock x:Name="CommentLabel"
                           Text="Комментарий (необязательно)"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="CommentTextBox"
                         Style="{StaticResource TextBoxStyle}"/>
            </StackPanel>
        </Grid>

        <Button x:Name="SaveGradeButton"
                Grid.Row="5"
                Content="Сохранить оценку"
                Style="{StaticResource PrimaryButtonStyle}"
                Width="240"
                HorizontalAlignment="Left"
                Margin="0,0,0,24"
                Click="SaveGradeButton_Click"/>

        <DataGrid x:Name="GradesDataGrid"
                  Grid.Row="6"
                  Style="{StaticResource AppDataGridStyle}"
                  MouseDoubleClick="GradesDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Задание"     Binding="{Binding material}" Width="*"/>
                <DataGridTextColumn Header="Тип"         Binding="{Binding type}"     Width="120"/>
                <DataGridTextColumn Header="Оценка"      Binding="{Binding grade}"    Width="100"/>
                <DataGridTextColumn Header="Дата"        Binding="{Binding date, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding comment}"  Width="250"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>