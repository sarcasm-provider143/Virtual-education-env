<Page x:Class="Virtual_education_env.Teacher.TeacherPages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчёт об успеваемости"
      Background="Transparent">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header"
                   Grid.Row="0"
                   Text="Отчёт об успеваемости"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="CourseLabel"
                       Text="Курс"
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="CourseComboBox"
                      Style="{StaticResource AppComboBoxStyle}"
                      Width="500"
                      HorizontalAlignment="Left"
                      SelectionChanged="CourseComboBox_SelectionChanged"/>
        </StackPanel>

        <Border x:Name="SummaryPanel"
                Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,14"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,48,0">
                    <TextBlock x:Name="SummaryStudentsLabel"
                               Text="Студентов на курсе"
                               Style="{StaticResource SubHeaderTextStyle}"/>
                    <TextBlock x:Name="SummaryStudentsValue"
                               Text="—"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>

                <StackPanel Margin="0,0,48,0">
                    <TextBlock x:Name="SummaryAvgLabel"
                               Text="Средний балл по курсу"
                               Style="{StaticResource SubHeaderTextStyle}"/>
                    <TextBlock x:Name="SummaryAvgValue"
                               Text="—"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>

                <StackPanel Margin="0,0,48,0">
                    <TextBlock x:Name="SummaryGradesLabel"
                               Text="Всего оценок"
                               Style="{StaticResource SubHeaderTextStyle}"/>
                    <TextBlock x:Name="SummaryGradesValue"
                               Text="—"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="SummaryBestLabel"
                               Text="Лучший студент"
                               Style="{StaticResource SubHeaderTextStyle}"/>
                    <TextBlock x:Name="SummaryBestValue"
                               Text="—"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="ReportDataGrid"
                  Grid.Row="3"
                  Style="{StaticResource AppDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Студент"        Binding="{Binding student}"     Width="*"/>
                <DataGridTextColumn Header="Группа"         Binding="{Binding group}"       Width="150"/>
                <DataGridTextColumn Header="Оценок"         Binding="{Binding count}"       Width="100"/>
                <DataGridTextColumn Header="Средний балл"   Binding="{Binding avgGrade}"    Width="150"/>
                <DataGridTextColumn Header="Итог"           Binding="{Binding finalGrade}"  Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>