<Page x:Class="Virtual_education_env.Teacher.TeacherPages.EnrollStudentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Запись студента"
      Background="Transparent">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Header"
                   Grid.Row="0"
                   Text="Запись студента на курс"
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="CourseLabel"
                       Text="Курс"
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="CourseComboBox"
                      Style="{StaticResource AppComboBoxStyle}"
                      Width="500"
                      HorizontalAlignment="Left"
                      SelectionChanged="CourseComboBox_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock x:Name="StudentLabel"
                       Text="Студент"
                       Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="StudentComboBox"
                      Style="{StaticResource AppComboBoxStyle}"
                      Width="500"
                      HorizontalAlignment="Left"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin=" 0 0 0 24">
            <Button x:Name="EnrollButton"
        Content="Записать на курс"
        Style="{StaticResource PrimaryButtonStyle}"
        Width="240"
        HorizontalAlignment="Left"
        Click="EnrollButton_Click"/>
            
            <Button x:Name="RemoveStudentButton"
        Content="Отчислить с курса"
        Style="{StaticResource SecondaryButtonStyle}"
        Width="240"
        HorizontalAlignment="Left"
        Margin="20 0 0 0"
        Click="RemoveStudentButton_Click"/>
        </StackPanel>
        
        
        

        <DataGrid x:Name="EnrolledDataGrid"
                  Grid.Row="4"
                  Style="{StaticResource AppDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Студент" Binding="{Binding student}" Width="*"/>
                <DataGridTextColumn Header="Группа"  Binding="{Binding group}"   Width="150"/>
                <DataGridTextColumn Header="Статус"  Binding="{Binding status}"  Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>